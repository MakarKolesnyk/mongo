use("mongo_3");

db.users.aggregate([
  {
    $unwind: "$favoiteGames",
  },
  {
    $group: {
      _id: "$favoiteGames",
      count: {
        $sum: 1,
      },
    },
  },
  {
    $sort: {
      count: -1,
    },
  },
  {
    $limit: 1,
  },
  {
    $lookup: {
      from: "games",
      localField: "_id",
      foreignField: "_id",
      as: "result",
    },
  },
  {
    $project: {
      _id: 0,
      count: 1,
      title: "$result.title",
    },
  },
]);

