use("mongo_3");

db.games.aggregate([
  {
    $lookup: {
      from: "developers",
      localField: "developId",
      foreignField: "_id",
      as: "developer",
    },
  },
  {
    $unwind: "$developer",
  },
  {
    $match: {
      "developer.country": { $in: ["Poland", "Ukraine"] },
    },
  },
  {
    $project: {
      _id: 0,
      title: 1,
      country: "$developer.country",
    },
  },
]);

