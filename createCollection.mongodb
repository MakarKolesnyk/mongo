// db.students.drop();

db.createCollection("students", {
  validator: {
    $jsonSchema: {
      bsonType: "object",
      required: ["fullName", "age", "subjects", "isOnline", "modul"],
      properties: {
        fullName: { bsonType: "string" },
        age: { bsonType: "int" },
        subjects: {
          bsonType: "array",
          minItems: 2,
          items: { bsonType: "string" },
        },
        isOnline: { bsonType: "bool" },
        modul: {
          bsonType: "int",
          enum: [1, 2, 3, 4, 5, 6],
        },
        createdAt: { bsonType: "date" },
      },
    },
  },
});
