use("mongo_4");

db.tracks.aggregate([
  {
    $match: {
      releaseYear: { $gt: 2022 },
    },
  },
  {
    $group: {
      _id: "$artistId",
      tracks: {
        $push: "$title",
      },
    },
  },
  {
    $lookup: {
      from: "artists",
      localField: "_id",
      foreignField: "_id",
      as: "artist",
    },
  },
  {
    $unwind: "$artist",
  },
  {
    $project: {
      _id: 0,
      tracks: 1,
      name: "$artist.name",
    },
  },
]);

