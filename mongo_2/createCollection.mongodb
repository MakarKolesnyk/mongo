db.createCollection("products", {
  validator: {
    $jsonSchema: {
      bsonType: "object",
      required: ["title", "price", "categoryId"],
      properties: {
        title: {
          bsonType: "string",
          minLength: 5,
          maxLength: 255,
          description: "Must be string [5-266]",
        },
        price: {
          bsonType: "int",
          minimum: 1,
          maximum: 1000000,
        },
        categoryId: {
          bsonType: "objectId",
        },
      },
    },
  },
});
